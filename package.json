{
  "name": "pedro-montalvao-advocacia-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Site institucional Pedro Montalvão Advocacia — Vite + React, conteúdo local em JSON, páginas pré-renderizadas para SEO.",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:client && npm run build:server && npm run prerender",
    "build:client": "vite build --outDir dist",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir .ssr-build",
    "prerender": "node scripts/prerender.mjs",
    "preview": "vite preview --outDir dist",
    "midias": "node scripts/optimize-media.mjs",
    "icones": "node scripts/gerar-icones.mjs",
    "typecheck": "tsc --noEmit",
    "test:artigos": "node scripts/auditar-artigos.mjs",
    "test:calculadoras": "vite build --ssr scripts/auditar-calculadoras.ts --outDir .audit-build && node .audit-build/auditar-calculadoras.js",
    "test:seo-calculadoras": "node scripts/auditar-seo-calculadoras.mjs",
    "test:numero-oficial": "vite build --ssr scripts/auditar-numero-oficial.ts --outDir .audit-build && node .audit-build/auditar-numero-oficial.js",
    "test:navegacao": "vite build --ssr scripts/auditar-navegacao.ts --outDir .audit-build && node .audit-build/auditar-navegacao.js",
    "test:triagem": "vite build --ssr scripts/auditar-triagem-sem-registro.ts --outDir .audit-build && node .audit-build/auditar-triagem-sem-registro.js",
    "test:triagem-completa": "vite build --ssr scripts/auditar-triagem-completa.ts --outDir .audit-build && node .audit-build/auditar-triagem-completa.js",
    "publicacao:preparar": "npm run build && npm run test:seo-calculadoras && node scripts/preparar-publicacao.mjs",
    "test:publicacao": "node scripts/auditar-publicacao.mjs"
  },
  "dependencies": {
    "lenis": "^1.3.26",
    "motion": "^13.0.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "sharp": "^0.35.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.0"
  }
}
